{
  "name": "pdfpcnic",
  "version": "1.1.3",
  "description": "pdfpc-style PDF presenter that runs in the browser, also as a single offline HTML file",
  "keywords": [
    "pdfpc",
    "presenter",
    "presentation",
    "pdf",
    "slides",
    "speaker-notes",
    "pdfjs",
    "typst",
    "touying",
    "beamer"
  ],
  "homepage": "https://youweizhuo.github.io/pdfpcnic/",
  "bugs": "https://github.com/youweizhuo/pdfpcnic/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youweizhuo/pdfpcnic.git"
  },
  "author": "Youwei Zhuo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --mode single && node scripts/copy-single.mjs",
    "build:site": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/core",
    "test": "node --test \"test/*.test.mjs\"",
    "e2e": "node scripts/e2e.mjs",
    "e2e:firefox": "node scripts/e2e-firefox.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299"
  }
}
