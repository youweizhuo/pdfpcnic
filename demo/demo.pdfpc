    { "idx": 0, "label": "1", "overlay": 0, "note": "**Welcome.** This is the title slide.\n\nThe timer starts when you leave this page, like pdfpc. Press **?** for all keys." },
    { "idx": 1, "label": "2", "overlay": 0, "note": "The audience window opens on the second screen when the browser allows window placement (Chrome, Edge).\n\n- Otherwise drag it to the projector\n- Double-click it, or press **Shift+W** here, for fullscreen" },
    { "idx": 2, "label": "3", "overlay": 0, "note": "Three reveal steps share one page label, so they count as **one slide**.\n\n*Next* on the right shows the next slide, not the next step." },
